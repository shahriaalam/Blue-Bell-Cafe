{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/assets/logo.png",
      "destination": "/assets/Logo and falcon/logo.png"
    },
    {
      "source": "/assets/Logo.png",
      "destination": "/assets/Logo and falcon/logo.png"
    },
    {
      "source": "/assets/favicon.png",
      "destination": "/assets/Logo and falcon/Falcon.jpg"
    },
    {
      "source": "/favicon.ico",
      "destination": "/assets/Logo and falcon/Falcon.jpg"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    }
  ]
}
